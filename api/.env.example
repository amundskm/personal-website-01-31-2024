# Copy to .env (git-ignored); compose.yaml loads it.

# Cognito user pool the site signs in with: see web/amplify_outputs.json (auth.user_pool_id / user_pool_client_id)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Shared secret the finances Lambda sends to /service/* (any long random string)
SERVICE_TOKEN=
