#!/bin/bash
# Creates or updates the QA environment (about $0.01/hour while its box exists):
# the QA content API at qa-api.neiaboiz.com, then a build of the QA site.
#
#   bin/qa-up    # deploys origin/qa; a new box starts with production's latest backup and images
#
# The QA workflow runs this on every merge into qa, and the production workflow
# deletes the box (bin/qa-down) once a release is live.
# Needs: the AWS CLI signed in (aws login), Docker, the QA deploy key, and
# .kamal/secrets.qa (see README.md).
set -euo pipefail
cd "$(dirname "$0")/.."

REGION=us-east-2
NAME=content-api-qa
HOST=qa-api.neiaboiz.com
ZONE_ID=Z057981539I3P54Q5JA3G
KEY_PAIR=personal-website-qa-deploy
export KAMAL_SSH_KEY="${KAMAL_SSH_KEY:-$HOME/.ssh/personal-website-qa-deploy}"
aws() { command aws --region "$REGION" "$@"; }

if ! aws lightsail get-instance --instance-name "$NAME" >/dev/null 2>&1; then
  echo "Creating the QA box…"
  aws lightsail create-instances --instance-names "$NAME" --availability-zone "${REGION}a" \
    --blueprint-id ubuntu_24_04 --bundle-id micro_3_0 --key-pair-name "$KEY_PAIR" \
    --user-data file://config/lightsail-init.sh --tags key=project,value=personal-website key=env,value=qa >/dev/null
fi
until [ "$(aws lightsail get-instance --instance-name "$NAME" --query instance.state.name --output text)" = running ]; do sleep 5; done
aws lightsail open-instance-public-ports --instance-name "$NAME" --port-info fromPort=443,toPort=443,protocol=tcp >/dev/null
ip=$(aws lightsail get-instance --instance-name "$NAME" --query instance.publicIpAddress --output text)

echo "Pointing $HOST at $ip…"
aws route53 change-resource-record-sets --hosted-zone-id "$ZONE_ID" --change-batch \
  "{\"Changes\":[{\"Action\":\"UPSERT\",\"ResourceRecordSet\":{\"Name\":\"$HOST\",\"Type\":\"A\",\"TTL\":60,\"ResourceRecords\":[{\"Value\":\"$ip\"}]}}]}" >/dev/null

echo "Waiting for the box to finish setting up…"
until ssh -i "$KAMAL_SSH_KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 "ubuntu@$ip" \
  test -f /var/lib/cloud/instance/content-api-ready 2>/dev/null; do sleep 10; done
# Kamal connects by host name: trust this box's host key for it
ssh-keygen -R "$HOST" >/dev/null 2>&1 || true
ssh -i "$KAMAL_SSH_KEY" -o StrictHostKeyChecking=accept-new "ubuntu@$HOST" true

echo "Copying production's images…"
command aws s3 sync s3://neiaboiz-site-images-production s3://neiaboiz-site-images-qa --only-show-errors

echo "Deploying…"
# setup is safe to repeat: it starts Postgres if needed, then deploys
bin/kamal setup -d qa

# A new (empty) database starts as a copy of production's; later deploys keep QA's edits
if bin/kamal app exec -d qa --reuse "bin/rails runner 'exit(Page.none?)'" >/dev/null 2>&1; then
  echo "Loading production's latest backup…"
  bin/kamal app exec -d qa --reuse "bin/backup restore latest production"
fi

bin/amplify-build qa
echo "QA API: https://$HOST  ·  QA site: https://qa.drxw6dozfluwp.amplifyapp.com"
