{
  "name": "personal-website",
  "private": true,
  "workspaces": [
    "web",
    "studio"
  ],
  "scripts": {
    "dev:web": "npm run start --workspace web",
    "dev:studio": "npm run dev --workspace studio",
    "build:web": "npm run build --workspace web",
    "build:studio": "npm run build --workspace studio",
    "deploy:studio": "npm run deploy --workspace studio",
    "typegen": "npm run typegen --workspace studio",
    "test": "npm run test --workspace web -- --watch=false"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
